#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp MINUS
&kp A            &kp S            &kp D            &kp F            &kp G            &kp H            &kp J            &kp K            &kp L            &kp P
&kp Z            &kp X            &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &kp DOT          &kp SLASH
&kp PSCRN        &kp LALT         &lt 1 TAB        &lt 2 ESC        &mt LSHFT DEL    &kp BSPC         &lt 4 ENTER      &lt 5 SPACE      &kp RCTRL        &kp HOME
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &kp MINUS  &kp N7     &kp N8     &kp N9     &trans
&trans     &trans     &trans     &kp EQUAL  &kp ASTRK  &kp PLUS   &kp N4     &kp N5     &kp N6     &trans
&trans     &trans     &trans     &trans     &kp SLASH  &kp MINUS  &kp N1     &kp N2     &kp N3     &trans
&trans     &trans     &trans     &trans     &trans     &kp COMMA  &kp DOT    &kp N0     &trans     &trans
            >;
        };

        layer2 {
            label = "YAJIRUSI";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp UP     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &kp LEFT   &kp DOWN   &kp RIGHT  &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &mkp MB3   &mkp MB1   &mkp MB2   &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &to 0      &kp RSHFT
            >;
        };

        layer4 {
            label = "SYOTOKATTO";
            bindings = <
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        layer5 {
            label = "KIGOU";
            bindings = <
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        layer6 {
            label = "FANKUSYON";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &to 3           &bt BT_SEL 4    &trans          &kp F7          &kp F8          &kp F9          &trans
&trans          &trans          &trans          &trans          &bt BT_CLR      &trans          &kp F4          &kp F5          &kp F6          &trans
&trans          &trans          &trans          &trans          &bt BT_CLR_ALL  &trans          &kp F1          &kp F2          &kp F3          &trans
&trans          &trans          &trans          &trans          &trans          &kp F12         &kp F11         &kp F10         &trans          &trans
            >;
        };

        layer7 {
            label = "Layer 7";
            bindings = <
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };
    };
};
